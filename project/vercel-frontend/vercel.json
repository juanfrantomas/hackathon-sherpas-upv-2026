{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TU-BACKEND-URL.trycloudflare.com/api/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "https://TU-BACKEND-URL.trycloudflare.com/videos/:path*"
    }
  ]
}

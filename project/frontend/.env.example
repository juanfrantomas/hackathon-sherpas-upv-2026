# Base URL of the backend (FastAPI, `project/backend`).
#
# Leave it unset to run the prototype on its static demo data: the app then
# never makes a network request and always works.
#
# The three names below are aliases of the same address, so a project that
# already had one of them keeps working:
#
#   VITE_BACKEND_API_URL      the address of the backend
#   VITE_MILESTONES_API_URL   alias
#   VITE_MENTOR_API_URL       alias
#
# VITE_BACKEND_API_URL=http://127.0.0.1:8001

# What to do when the live mentor cannot be reached:
#   scripted - fall back to the scripted answer and keep the demo working
#   error    - show the mentor's error state ("Try again" / "Read my plan")
# VITE_MENTOR_FALLBACK=scripted

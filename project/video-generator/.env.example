# API server
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000

# LLM proxy
LLM_BASE_URL= # Your url
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=false
LLM_MAX_ATTEMPTS=1

# Default development mode
DEMO_MODE=true
AUDIO_MODE=none
PROXY_TTS_MODEL=eleven-flash-v2.5
PROXY_TTS_VOICE=alloy
GENERATE_MUSIC=false
MUSIC_FILE=assets/background-music.mp3

# Video
MAX_VIDEO_SECONDS=180
VIDEO_FPS=30

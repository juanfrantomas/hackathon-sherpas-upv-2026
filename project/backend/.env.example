# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# --- Sherpas MCP ----------------------------------------------------------
# MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
# MCP_TOKEN=your-personal-mcp-token
# auto | mcp | local  (auto = MCP first, fall back to ../cases/*.json)
CASE_SOURCE=auto
# Directory holding the offline case payloads (financial-health.json, ...).
CASES_DIR=../../cases

# --- AI provider (provider-agnostic) -------------------------------------
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://llm-hackathon.sherpaswealth.com/v1
# TEAM_KEY=your-team-ai-key
AI_MODEL=gpt-5-mini
# The model that writes the copy of the pillars (no reasoning, no cost)
AI_COPY_MODEL=gemini-3.5-flash-lite
AI_MAX_CONCURRENCY=4
AI_TIMEOUT_S=90
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=20000

# --- Digest / generation --------------------------------------------------
DIGEST_MAX_CHARS=60000
AI_GENERATION_ENABLED=true
AUTO_GENERATE_ON_FIRST_ACCESS=true

# --- Sync -----------------------------------------------------------------
SYNC_MIN_INTERVAL_MINUTES=1440

# --- Security -------------------------------------------------------------
# Comma separated allowlist of caseIds. Empty = deny everything (fail closed).
ALLOWED_CASE_IDS=
# Comma separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# --- Notifications ---------------------------------------------------------
NOTIFICATION_INTERVAL_SECONDS=300

# --- Misc -----------------------------------------------------------------
PLAN_TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO
ENVIRONMENT=development
